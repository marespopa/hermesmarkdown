#!/usr/bin/env bash
# HermesMarkdown factory: moves plan folders in next-client/plans/NNN-<slug>/
# through new → specced → building → review → approved, one stage per run,
# using the hermes-architect / hermes-engineer / hermes-review agents.
#
# Everything is a dry run unless --commit is passed. Agents never commit:
# the guard hook (.claude/hooks/factory-guard.sh) blocks git writes and this
# script blocks the plan if HEAD or the branch moved during a stage.
#
# See next-client/plans/README.md for the folder contract and states.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
PLANS="$ROOT/next-client/plans"
CLAUDE_BIN=${FACTORY_CLAUDE:-claude}
PERMISSION_MODE=${FACTORY_PERMISSION_MODE:-acceptEdits}
# Design gets the strongest model; implementing a settled PRD and reviewing it
# against that PRD run on a cheaper one. Override per stage with these vars.
MODEL_ARCHITECT=${FACTORY_MODEL_ARCHITECT:-opus}
MODEL_ENGINEER=${FACTORY_MODEL_ENGINEER:-sonnet}
MODEL_REVIEW=${FACTORY_MODEL_REVIEW:-sonnet}
MAX_REJECTIONS=2
MAX_ATTEMPTS=2
COMMIT=0
SMALL=0
KIND=feature
NEW_BODY=""
MAX_SHIP_STAGES=10

die() { echo "factory: $*" >&2; exit 1; }
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

usage() {
  cat <<'EOF'
Usage: scripts/factory <command> [args] [--commit]

  ship "<feature or bug>" [--bug] [--small] [--commit]
                          The whole pipeline: plan → stages → commit → release PR.
                          --bug: patch release, small plan, starts from a failing test
  ship NNN [--commit]     Continue a plan (e.g. after unblock) through to the PR

  new <slug> [title...] [--small]
                          Scaffold next-client/plans/NNN-<slug>/brief.md (state: new);
                          --small skips the architect: the brief is the spec
  list                    Show every factory plan with its state and spend
  stats                   Spend, fix rounds and first-review approval rate, archive included
  run [NNN] [--commit]    Advance one plan (or every runnable plan) by one stage
  unblock NNN [--commit]  Fold answers in blocked.md back into the PRD and resume
  learn NNN [--commit]    Propose rule changes from a finished plan's corrections
                          (writes reports/lessons.md; nothing else changes)
  set NNN <state>         Set a state by hand (e.g. merged after you merge the PR)

Without --commit, run and unblock only print what they would do.

Models: FACTORY_MODEL_ARCHITECT (opus), FACTORY_MODEL_ENGINEER (sonnet),
FACTORY_MODEL_REVIEW (sonnet).
EOF
}

# --- frontmatter helpers (brief.md starts with a --- block) -----------------

fm_get() { # file key
  awk -v k="$2" 'NR==1&&/^---$/{f=1;next} f&&/^---$/{exit}
    f{i=index($0,":"); if(substr($0,1,i-1)==k){v=substr($0,i+1); sub(/^[ \t]+/,"",v); print v; exit}}' "$1"
}

fm_set() { # file key value
  local tmp; tmp=$(mktemp)
  awk -v k="$2" -v v="$3" 'NR==1&&/^---$/{f=1;print;next}
    f&&/^---$/{if(!done)print k": "v; f=0; print; next}
    f{i=index($0,":"); if(substr($0,1,i-1)==k){print k": "v; done=1; next}}
    {print}' "$1" >"$tmp"
  cat "$tmp" >"$1"; rm -f "$tmp"
}

# --- plan lookup ------------------------------------------------------------

plan_dirs() { find "$PLANS" -mindepth 1 -maxdepth 1 -type d -name '[0-9][0-9][0-9]-*' 2>/dev/null | sort; }

archive_dirs() { find "$PLANS/archive" -mindepth 1 -maxdepth 1 -type d -name '[0-9][0-9][0-9]-*' 2>/dev/null | sort; }

plan_dir() { # NNN or NNN-slug
  local d; d=$(plan_dirs | grep -E "/$(printf '%03d' "$((10#${1%%-*}))")-" | head -n1 || true)
  [ -n "$d" ] && [ -f "$d/brief.md" ] || die "no plan $1 in next-client/plans/"
  echo "$d"
}

rel() { echo "${1#"$ROOT"/}"; }

# --- run bookkeeping (.run.json is gitignored) ------------------------------

run_attempts() { [ -f "$1/.run.json" ] && sed -n 's/.*"attempts": *\([0-9]*\).*/\1/p' "$1/.run.json" || echo 0; }

run_field() { # dir key — a string field from .run.json
  [ -f "$1/.run.json" ] && sed -n "s/.*\"$2\": *\"\([^\"]*\)\".*/\1/p" "$1/.run.json" || true
}

write_run() { # dir stage agent attempts exit [session]
  printf '{\n  "stage": "%s",\n  "agent": "%s",\n  "attempts": %s,\n  "lastExit": %s,\n  "session": "%s",\n  "finishedAt": "%s",\n  "log": ".run.log"\n}\n' \
    "$2" "$3" "$4" "$5" "${6:-}" "$(now)" >"$1/.run.json"
}

# --- usage (usage.tsv is committed so spend can be compared across plans) ----

log_num() { # log key — first numeric value of "key" in the JSON result
  grep -o "\"$2\": *[0-9.]*" "$1" 2>/dev/null | head -n1 | sed 's/.*: *//' || true
}

log_session() { grep -o '"session_id": *"[^"]*"' "$1" 2>/dev/null | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true; }

record_usage() { # dir from agent model attempt exit
  local dir=$1 log="$1/.run.log" f="$1/usage.tsv"
  [ -f "$f" ] || printf 'finished\tfrom\tagent\tmodel\tattempt\texit\tcost_usd\tturns\tduration_ms\tinput\tcache_write\tcache_read\toutput\n' >"$f"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(now)" "$2" "$3" "$4" "$5" "$6" \
    "$(log_num "$log" total_cost_usd)" "$(log_num "$log" num_turns)" "$(log_num "$log" duration_ms)" \
    "$(log_num "$log" input_tokens)" "$(log_num "$log" cache_creation_input_tokens)" \
    "$(log_num "$log" cache_read_input_tokens)" "$(log_num "$log" output_tokens)" >>"$f"
}

total_cost() { # dir
  [ -f "$1/usage.tsv" ] || return 0
  awk -F'\t' 'NR>1{s+=$7} END{if(NR>1) printf "$%.2f", s}' "$1/usage.tsv"
}

mailbox() { # dir message
  printf -- '- %s — factory: %s\n' "$(now)" "$2" >>"$1/mailbox.md"
}

block() { # dir from reason (from=blocked keeps the original blocked_from)
  fm_set "$1/brief.md" state blocked
  [ "$2" = blocked ] || fm_set "$1/brief.md" blocked_from "$2"
  printf '\n## Technical block — %s\n\n%s\n\nAnswer:\n' "$(now)" "$3" >>"$1/blocked.md"
  echo "  → blocked: $3"
}

# --- rails ------------------------------------------------------------------

code_dirty() { [ -n "$(git -C "$ROOT" status --porcelain -- . ':(exclude)next-client/plans')" ]; }

check_branch() {
  local b; b=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)
  case "$b" in trunk|main|master) die "refusing to run on $b; switch to a release branch first" ;; esac
}

# --- stages -----------------------------------------------------------------

is_small() { [ "$(fm_get "$1/brief.md" size)" = small ]; }

# The spec the engineer and reviewer work from: prd.md, or brief.md for small plans.
spec_for() { # dir
  if is_small "$1" && [ ! -f "$1/prd.md" ]; then echo brief.md; else echo prd.md; fi
}

model_for() { # agent
  case "$1" in
    hermes-architect) echo "$MODEL_ARCHITECT" ;;
    hermes-engineer) echo "$MODEL_ENGINEER" ;;
    *) echo "$MODEL_REVIEW" ;;
  esac
}

# Prints "agent|expected next states|prompt" for a plan state, or nothing if idle.
stage_for() { # state dir
  local r spec; r=$(rel "$2"); spec=$(spec_for "$2")
  local small=""
  local PR_NOTE="a '## <feature or fix name>' heading, then 2-6 short bullets: user-visible behavior first, then wiring worth a reviewer's attention; no person names"
  [ "$spec" = brief.md ] && small=" Small plan: there is no prd.md — $r/brief.md is the whole spec."
  case "$1" in
    new) if [ -n "$small" ]; then
           echo "hermes-engineer|review blocked|Factory mode. Plan folder: $r.$small Implement it. Read $r/mailbox.md first: it holds RESUME notes from interrupted runs. Write your report to $r/reports/engineer.md, the release-PR section to $r/reports/pr.md ($PR_NOTE), and a one-line handoff to $r/mailbox.md. If the brief is missing a design-changing decision, write it to $r/blocked.md and set state: blocked. Otherwise set state: review in $r/brief.md frontmatter as your last action."
           return
         fi
         echo "hermes-architect|specced blocked|Factory mode. Plan folder: $r. Read $r/brief.md (the product brief) and $r/mailbox.md, then write the engineering PRD to $r/prd.md and your report to $r/reports/architect.md. If a design-changing decision is missing, write the questions to $r/blocked.md instead and set state: blocked. Otherwise set state: specced in $r/brief.md frontmatter as your last action." ;;
    specced|building|changes-requested) echo "hermes-engineer|review blocked|Factory mode. Plan folder: $r.$small Implement $r/$spec (all phases unless the brief limits them). Read $r/mailbox.md first: it holds RESUME notes from interrupted runs and the reviewer's fix list after a rejection — address those. Write your report to $r/reports/engineer.md, the release-PR section to $r/reports/pr.md ($PR_NOTE), and a one-line handoff to $r/mailbox.md. If the spec is missing a design-changing decision, write it to $r/blocked.md and set state: blocked. Otherwise set state: review in $r/brief.md frontmatter as your last action." ;;
    review) echo "hermes-review|approved changes-requested blocked|Factory mode. Plan folder: $r.$small Review the uncommitted working-tree change against $r/$spec. Write the review to $r/reports/review.md. On Approve or Approve with nits set state: approved; on Changes requested append the fix list to $r/mailbox.md and set state: changes-requested — both in $r/brief.md frontmatter as your last action." ;;
    *) ;;
  esac
}

# One headless agent session under the factory rails; output goes to .run.log.
claude_session() { # dir agent model prompt [extra claude args...]
  local dir=$1 agent=$2 model=$3 prompt=$4; shift 4
  (cd "$ROOT" && HERMES_FACTORY=1 "$CLAUDE_BIN" -p "$prompt" --agent "$agent" --model "$model" \
      "$@" --permission-mode "$PERMISSION_MODE" \
      --allowedTools "Bash(corepack yarn *)" "Bash(git status*)" "Bash(git diff*)" "Bash(git log*)" "Bash(git ls-files*)" "Bash(git show*)" "Bash(wc *)" "Bash(ls *)" \
      --disallowedTools "Bash(git commit *)" "Bash(git push *)" "Bash(git reset *)" "Bash(git checkout *)" "Bash(git rebase *)" "Bash(git stash *)" \
      --output-format json) >"$dir/.run.log" 2>&1
}

run_stage() { # dir agent expected prompt from_state
  local dir=$1 agent=$2 expected=$3 prompt=$4 from=$5
  local head0 branch0 attempts code=0 state model session resume=()
  attempts=$(( $(run_attempts "$dir") + 1 ))
  model=$(model_for "$agent")
  # A retry of the same stage picks up the failed session instead of re-exploring cold.
  session=$(run_field "$dir" session)
  if [ "$attempts" -gt 1 ] && [ -n "$session" ] && [ "$(run_field "$dir" agent)" = "$agent" ]; then
    resume=(--resume "$session")
  fi
  head0=$(git -C "$ROOT" rev-parse HEAD); branch0=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)
  if [ "$agent" = hermes-engineer ] && [ "$from" != building ]; then fm_set "$dir/brief.md" state building; fi
  mkdir -p "$dir/reports"

  echo "  running $agent on $model (attempt $attempts${resume[*]:+, resuming}, log $(rel "$dir")/.run.log)"
  claude_session "$dir" "$agent" "$model" "$prompt" ${resume[@]+"${resume[@]}"} || code=$?
  write_run "$dir" "$from" "$agent" "$attempts" "$code" "$(log_session "$dir/.run.log")"
  record_usage "$dir" "$from" "$agent" "$model" "$attempts" "$code"

  if [ "$(git -C "$ROOT" rev-parse HEAD)" != "$head0" ] || [ "$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)" != "$branch0" ]; then
    block "$dir" "$from" "HEAD or branch moved during the $agent stage ($head0 on $branch0). Agents must not commit; inspect git log/reflog before resuming."
    return
  fi

  state=$(fm_get "$dir/brief.md" state)
  if [ "$code" -ne 0 ] || [ -z "$state" ] || ! grep -qw -- "$state" <<<"$expected"; then
    mailbox "$dir" "RESUME: $agent stage from '$from' did not finish (exit $code, state '$state'). Check the working tree and $(rel "$dir")/.run.log, then continue rather than restart."
    fm_set "$dir/brief.md" state "$from"
    if [ "$attempts" -ge "$MAX_ATTEMPTS" ]; then
      block "$dir" "$from" "$agent failed $attempts times in a row (last exit $code). See .run.log."
    else
      echo "  → stage incomplete (exit $code); state stays '$from'"
    fi
    return
  fi

  write_run "$dir" "$state" "$agent" 0 "$code"
  if [ "$state" = changes-requested ]; then
    local rej; rej=$(fm_get "$dir/brief.md" rejections); rej=$(( ${rej:-0} + 1 ))
    fm_set "$dir/brief.md" rejections "$rej"
    if [ "$rej" -ge "$MAX_REJECTIONS" ]; then
      block "$dir" changes-requested "Review rejected the change $rej times. Read reports/review.md and decide: adjust the PRD, fix by hand, or answer below and unblock."
      return
    fi
  fi
  echo "  → $state"
}

advance() { # dir
  local dir=$1 state stage agent expected prompt
  state=$(fm_get "$dir/brief.md" state)
  stage=$(stage_for "$state" "$dir")
  echo "$(basename "$dir") [$state]"
  if [ -z "$stage" ]; then echo "  idle (needs a human: ${state})"; return; fi
  IFS='|' read -r agent expected prompt <<<"$stage"
  if { [ "$state" = specced ] || { [ "$state" = new ] && is_small "$dir"; }; } && code_dirty; then
    echo "  skipped: uncommitted code changes outside plans/ (another plan's work?) — commit or stash them first"
    return
  fi
  if [ "$COMMIT" -eq 0 ]; then
    echo "  would run $agent on $(model_for "$agent") → expects: ${expected// / | }   (dry run; add --commit)"
    return
  fi
  run_stage "$dir" "$agent" "$expected" "$prompt" "$state"
}

# --- commands ---------------------------------------------------------------

BRIEF_TEMPLATE='## Problem
<!-- Who is affected and what hurts today. -->

## Desired behavior
<!-- What the user should be able to do. Edge cases you already know. -->

## Out of scope
<!-- What not to build now. -->'

cmd_new() {
  [ $# -ge 1 ] || die "usage: factory new <slug> [title...]"
  local slug=$1; shift
  [[ $slug =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug must be kebab-case"
  local last n dir title=${*:-$slug}
  # Archived plans (plans/archive/NNN-*) keep their numbers, so count them too.
  last=$({ plan_dirs; archive_dirs; } \
    | sed -E 's|.*/([0-9]{3})-.*|\1|' | sort | tail -n1)
  n=$(printf '%03d' $(( 10#${last:-0} + 1 )))
  dir="$PLANS/$n-$slug"
  mkdir -p "$dir/reports"
  cat >"$dir/brief.md" <<EOF
---
state: new
size: $([ "$SMALL" -eq 1 ] && echo small || echo normal)
kind: $KIND
blocked_from:
rejections: 0
created: $(now)
---

# $title

${NEW_BODY:-$BRIEF_TEMPLATE}
EOF
  : >"$dir/mailbox.md"
  echo "created $(rel "$dir")/brief.md — fill it in, then: scripts/factory run $n"
}

cmd_list() {
  printf '%-4s %-34s %-18s %-8s %s\n' NNN SLUG STATE SPENT NOTE
  local d s note
  for d in $(plan_dirs); do
    s=$(fm_get "$d/brief.md" state)
    note=""
    [ "$s" = blocked ] && note="from $(fm_get "$d/brief.md" blocked_from); see blocked.md"
    [ "$(fm_get "$d/brief.md" rejections)" -gt 0 ] 2>/dev/null && note="${note:+$note; }rejections $(fm_get "$d/brief.md" rejections)"
    local b; b=$(basename "$d")
    is_small "$d" && note="${note:+$note; }small"
    printf '%-4s %-34s %-18s %-8s %s\n' "${b%%-*}" "${b#*-}" "$s" "$(total_cost "$d")" "$note"
  done
}

# Factory metrics from every usage.tsv, archived plans included. A plan is done
# when approved or merged; it passed on first review when its only successful
# review run approved it. Fix rounds are successful reviews that didn't approve.
cmd_stats() {
  local d s
  for d in $(plan_dirs) $(archive_dirs); do
    [ -f "$d/usage.tsv" ] || continue
    s=$(fm_get "$d/brief.md" state)
    awk -F'\t' -v p="$(basename "$d")" -v s="${s:-?}" 'NR>1{print p"\t"s"\t"$0}' "$d/usage.tsv"
  done | awk -F'\t' '
    # $1 plan, $2 state, then usage.tsv: $4 from, $5 agent, $8 exit, $9 cost_usd
    {
      p=$1; if (!(p in st)) { order[++n]=p; st[p]=$2 }
      cost[p]+=$9; total+=$9
      if ($4=="learn") { by["learn"]+=$9; next }
      by[$5]+=$9; runs[p]++; allruns++
      if ($8!=0) { failed[p]++; allfailed++ }
      else if ($4=="review") reviews[p]++
    }
    END {
      if (n==0) { print "no usage.tsv yet: run a plan with --commit first"; exit }
      printf "%-4s %-34s %-18s %4s %6s %5s %8s\n", "NNN", "SLUG", "STATE", "RUNS", "FAILED", "FIXES", "SPENT"
      for (i=1; i<=n; i++) {
        p=order[i]; isdone=(st[p]=="approved" || st[p]=="merged")
        fixes=reviews[p]-(isdone && reviews[p]>0 ? 1 : 0)
        if (isdone) { done++; donecost+=cost[p] }
        if (isdone && reviews[p]>0) { judged++; if (reviews[p]==1) firstpass++ }
        slug=p; sub(/^[0-9]+-/, "", slug)
        printf "%-4s %-34s %-18s %4d %6d %5d %8s\n", substr(p,1,3), slug, st[p], runs[p], failed[p], fixes, sprintf("$%.2f", cost[p])
      }
      printf "\nPlans with spend: %d (done: %d)\n", n, done
      printf "Total spend: $%.2f", total
      if (done) printf "; per done plan: $%.2f", donecost/done
      printf "\nApproved on first review: %d/%d", firstpass, judged
      if (judged) printf " (%.0f%%)", 100*firstpass/judged
      printf "\nFailed stage runs: %d/%d\n", allfailed, allruns
      printf "Spend by agent:"
      split("hermes-architect hermes-engineer hermes-review learn", ag, " ")
      for (i=1; i<=4; i++) if (ag[i] in by) printf "  %s $%.2f", ag[i], by[ag[i]]
      printf "\n"
    }'
}

# Turns a finished plan's corrections into proposed rule changes. The agent
# only writes reports/lessons.md; the human applies the proposals they accept.
cmd_learn() {
  [ $# -ge 1 ] || die "usage: factory learn NNN [--commit]"
  check_branch
  local dir r state before code=0; dir=$(plan_dir "$1"); r=$(rel "$dir"); state=$(fm_get "$dir/brief.md" state)
  case "$state" in approved|merged) ;; *) die "$(basename "$dir") is '$state'; learn runs on approved or merged plans" ;; esac
  echo "$(basename "$dir") [$state]"
  if [ "$COMMIT" -eq 0 ]; then
    echo "  would run hermes-review on $MODEL_REVIEW to write $r/reports/lessons.md (dry run; add --commit)"
    return
  fi
  mkdir -p "$dir/reports"
  before=$({ cksum <"$dir/reports/lessons.md"; } 2>/dev/null || true)
  echo "  running hermes-review on $MODEL_REVIEW (log $r/.run.log)"
  claude_session "$dir" hermes-review "$MODEL_REVIEW" \
    "Factory mode, learn. Plan folder: $r. This plan is finished; find what went wrong on the way so later plans avoid it. Read $r/mailbox.md (fix lists, RESUME notes, orchestrator notes), $r/reports/review.md and $r/usage.tsv (failed runs, fix rounds). Then read next-client/AGENT_RULES.md, next-client/AGENTS.md, the agent definitions in .claude/agents/ and the stage prompts in scripts/factory to see which rules already exist. For each correction a reviewer, the orchestrator or the human had to make, decide whether a missing or unclear rule caused it. Skip bugs that are specific to this feature. Write $r/reports/lessons.md with at most 5 proposals, most valuable first. Each one gives the target file, the exact text to add or replace (matching that file's tone and length), the evidence (quote the mailbox or review lines), and why it applies beyond this plan. End with a short list of the corrections you judged one-off, and why. Edit no file other than $r/reports/lessons.md." \
    || code=$?
  record_usage "$dir" learn hermes-review "$MODEL_REVIEW" 1 "$code"
  if [ "$code" -ne 0 ] || [ ! -s "$dir/reports/lessons.md" ] || [ "$(cksum <"$dir/reports/lessons.md")" = "$before" ]; then
    die "learn did not write a new $r/reports/lessons.md (exit $code); see $r/.run.log"
  fi
  echo "  → $r/reports/lessons.md: apply the proposals you agree with"
}

# --- ship: request → plan → stages → commit → release PR --------------------

pkg_version() { # git rev
  git -C "$ROOT" show "$1:next-client/package.json" | sed -n 's/^  "version": "\(.*\)",$/\1/p'
}

next_version() { # version minor|patch
  local IFS=.; set -- $1 "$2"
  if [ "$4" = minor ]; then echo "$1.$(( $2 + 1 )).0"; else echo "$1.$2.$(( $3 + 1 ))"; fi
}

# Stay on the current release branch while its version is unreleased (no tag);
# otherwise start release/<next> from origin/trunk and commit the version bump.
release_branch() { # minor|patch
  local b ver next
  git -C "$ROOT" fetch -q --tags origin trunk
  b=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD); ver=$(pkg_version HEAD)
  if [ "$b" = "release/$ver" ] && ! git -C "$ROOT" rev-parse -q --verify "refs/tags/v$ver" >/dev/null; then
    echo "  on $b (unreleased): the change joins this release"
    return
  fi
  next=$(next_version "$(pkg_version origin/trunk)" "$1")
  git -C "$ROOT" checkout -q -b "release/$next" origin/trunk
  (cd "$ROOT/next-client" && node scripts/bump-version.mjs "--$1" >/dev/null)
  [ "$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$ROOT/next-client/package.json")" = "$next" ] \
    || die "version bump didn't produce $next"
  git -C "$ROOT" commit -q -am "Bump the version to $next"
  echo "  started release/$next from origin/trunk (version bumped)"
}

needs_learn() { # dir — true when a stage failed or review sent the change back
  [ -f "$1/usage.tsv" ] && awk -F'\t' 'NR>1 && $2!="learn" { if ($6!=0) bad=1; else if ($2=="review") r++ }
    END { exit !(bad || r>1) }' "$1/usage.tsv"
}

pr_section() { # dir title
  if [ -s "$1/reports/pr.md" ]; then cat "$1/reports/pr.md"
  else printf '## %s\n\n- Factory plan `%s`.\n' "$2" "$(rel "$1")"; fi
}

# Opens the release PR, or adds this plan's section (above ## Checks) to the open one.
release_pr() { # dir title
  local b ver num tmp; b=$(git -C "$ROOT" rev-parse --abbrev-ref HEAD); ver=${b#release/}
  tmp=$(mktemp)
  git -C "$ROOT" push -q -u origin "$b"
  num=$(cd "$ROOT" && gh pr list --head "$b" --state open --json number --jq '.[0].number // empty')
  if [ -z "$num" ]; then
    { printf '%s. Bumps the version to %s.\n\n' "$2" "$ver"; pr_section "$1" "$2"
      printf '\n## Checks\n\nTypecheck, lint, tests and build run in CI on this PR. Built by the factory; nothing was checked in a browser or on a device.\n'
    } >"$tmp"
    (cd "$ROOT" && gh pr create --base trunk --head "$b" --label release --title "Release $ver" --body-file "$tmp" >/dev/null)
    num=$(cd "$ROOT" && gh pr list --head "$b" --state open --json number --jq '.[0].number')
    echo "  opened PR #$num (Release $ver)"
  else
    # gh pr edit fails on this repo (Projects classic), so the body goes through REST.
    (cd "$ROOT" && gh api "repos/{owner}/{repo}/pulls/$num" --jq .body) \
      | SECT=$(pr_section "$1" "$2") awk '/^## Checks/ && !done { print ENVIRON["SECT"] "\n"; done=1 } { print } END { if (!done) print "\n" ENVIRON["SECT"] }' >"$tmp"
    (cd "$ROOT" && gh api -X PATCH "repos/{owner}/{repo}/pulls/$num" -F "body=@$tmp" >/dev/null)
    echo "  pushed to PR #$num and added this change to its description"
  fi
  rm -f "$tmp"
  echo "  CI is running: gh pr checks $num --watch"
}

cmd_ship() {
  [ $# -ge 1 ] || die 'usage: factory ship "<feature or bug>" [--bug] [--small] [--commit]  |  factory ship NNN [--commit]'
  command -v gh >/dev/null || die "ship needs the gh CLI"
  local dir state title slug i bump=minor n
  [ "$KIND" = bug ] && bump=patch
  if [[ $1 =~ ^[0-9]{1,3}$ ]]; then
    dir=$(plan_dir "$1"); title=$(sed -n 's/^# //p' "$dir/brief.md" | head -n1)
    KIND=$(fm_get "$dir/brief.md" kind); KIND=${KIND:-feature}
    check_branch
    if [ "$COMMIT" -eq 0 ]; then
      echo "would continue $(basename "$dir") [$(fm_get "$dir/brief.md" state)] to approved, then commit and push to the release PR (dry run; add --commit)"
      return
    fi
  else
    title=$(printf '%s' "$*" | head -n1 | cut -c1-72)
    slug=$(printf '%s' "$title" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//' | cut -d- -f1-5 | sed 's/-*$//')
    [ -n "$slug" ] || die "can't make a slug from: $title"
    if [ "$COMMIT" -eq 0 ]; then
      echo "would ship a $KIND: \"$title\""
      echo "  1. use the current release branch if it's unreleased, else release/<next $bump> from origin/trunk"
      echo "  2. create plan <NNN>-$slug ($([ "$SMALL" -eq 1 ] && echo small || echo normal))"
      echo "  3. run stages until approved (stops if blocked), plus learn if review sent it back"
      echo "  4. commit, push, open or update the 'Release X.Y.Z' PR; CI runs the checks"
      echo "(dry run; add --commit)"
      return
    fi
    [ -z "$(git -C "$ROOT" status --porcelain)" ] || die "the working tree isn't clean; commit or stash first so the release commit holds only this change"
    release_branch "$bump"
    if [ "$KIND" = bug ]; then
      NEW_BODY="## Problem
$*

## Desired behavior
The bug is fixed. First write a test that reproduces it (it fails on the current code), then fix the code so it passes.

## Out of scope
Changes the fix doesn't need."
    else
      NEW_BODY="## Desired behavior
$*

## Out of scope
Anything the request doesn't ask for."
    fi
    cmd_new "$slug" "$title" >/dev/null
    dir=$(plan_dirs | tail -n1)
    echo "  created $(rel "$dir")"
  fi

  for (( i = 0; i < MAX_SHIP_STAGES; i++ )); do
    state=$(fm_get "$dir/brief.md" state)
    case "$state" in
      approved) break ;;
      merged) die "$(basename "$dir") is already merged" ;;
      blocked)
        # Answered questions resume on their own; unanswered ones end the run.
        if grep -q '^Answer:' "$dir/blocked.md" 2>/dev/null && ! grep -Eq '^Answer:[[:space:]]*$' "$dir/blocked.md"; then
          cmd_unblock "${dir##*/}"
          continue
        fi
        n=$(basename "$dir"); n=${n%%-*}
        echo "blocked: answer the questions in $(rel "$dir")/blocked.md, then: scripts/factory ship $n --commit"
        exit 3 ;;
    esac
    advance "$dir"
  done
  [ "$(fm_get "$dir/brief.md" state)" = approved ] || die "stopped after $MAX_SHIP_STAGES stages at '$(fm_get "$dir/brief.md" state)'"

  if needs_learn "$dir"; then
    ( cmd_learn "${dir##*/}" ) || echo "  learn failed; shipping anyway"
  fi

  git -C "$ROOT" add -A
  if git -C "$ROOT" diff --cached --quiet; then
    echo "  nothing new to commit"
  else
    git -C "$ROOT" commit -q -m "$title" -m "$([ "$KIND" = bug ] && echo Fix || echo Feature) from factory plan $(rel "$dir")."
    echo "  committed: $title"
  fi
  release_pr "$dir" "$title"
}

cmd_run() {
  check_branch
  if [ $# -ge 1 ]; then advance "$(plan_dir "$1")"; return; fi
  local d; for d in $(plan_dirs); do advance "$d"; done
}

cmd_unblock() {
  [ $# -ge 1 ] || die "usage: factory unblock NNN [--commit]"
  check_branch
  local dir from r spec; dir=$(plan_dir "$1"); r=$(rel "$dir"); spec=$(spec_for "$dir")
  [ "$(fm_get "$dir/brief.md" state)" = blocked ] || die "$(basename "$dir") is not blocked"
  from=$(fm_get "$dir/brief.md" blocked_from); from=${from:-new}
  if grep -Eq '^Answer:[[:space:]]*$' "$dir/blocked.md" 2>/dev/null; then
    die "$r/blocked.md still has empty 'Answer:' lines — answer every question first"
  fi
  echo "$(basename "$dir") [blocked from $from]"
  if [ "$COMMIT" -eq 0 ]; then echo "  would run hermes-architect to fold answers, then resume at '$from' (dry run; add --commit)"; return; fi
  run_stage "$dir" hermes-architect "$from" \
    "Factory mode, unblock. Plan folder: $r. The human answered the questions in $r/blocked.md. Fold each answer into $r/$spec (Decisions, and any affected Behavior/Design/Phase sections; in brief.md add a ## Decisions section and leave the frontmatter alone), append the answered questions to $r/mailbox.md, then empty $r/blocked.md. As your last action set state: $from and clear blocked_from in $r/brief.md frontmatter." \
    blocked
  if [ "$(fm_get "$dir/brief.md" state)" != blocked ]; then
    fm_set "$dir/brief.md" blocked_from ""
    fm_set "$dir/brief.md" rejections 0
  fi
}

cmd_set() {
  [ $# -eq 2 ] || die "usage: factory set NNN <state>"
  case "$2" in new|specced|building|review|changes-requested|approved|merged|blocked) ;; *) die "unknown state $2" ;; esac
  local dir; dir=$(plan_dir "$1")
  fm_set "$dir/brief.md" state "$2"
  [ "$2" = blocked ] || fm_set "$dir/brief.md" blocked_from ""
  echo "$(basename "$dir") → $2"
}

args=()
for a in "$@"; do
  case "$a" in --commit) COMMIT=1 ;; --small) SMALL=1 ;; --bug) KIND=bug; SMALL=1 ;; *) args+=("$a") ;; esac
done
set -- "${args[@]+"${args[@]}"}"

cmd=${1:-help}; shift || true
case "$cmd" in
  new) cmd_new "$@" ;;
  list|ls) cmd_list ;;
  stats) cmd_stats ;;
  learn) cmd_learn "$@" ;;
  ship) cmd_ship "$@" ;;
  run) cmd_run "$@" ;;
  unblock) cmd_unblock "$@" ;;
  set) cmd_set "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
